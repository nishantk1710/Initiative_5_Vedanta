# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Both the Next.js app and the Python service read this same single file
# (python/main.py loads it via python-dotenv).
#
# Use .env ONLY — do not also create a .env.local. Next.js gives .env.local
# precedence over .env automatically, so a stray .env.local with blank
# values will silently shadow real credentials here.

# ---------------------------------------------------------------------
# Python FastAPI service
# ---------------------------------------------------------------------
# Where the Next.js server-side routes reach the Python service.
# Server-side only — deliberately NOT prefixed NEXT_PUBLIC_, so it is
# never exposed to the browser.
PYTHON_API_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Azure AI Foundry (optional)
# ---------------------------------------------------------------------
# Used for two things only:
#   1. Normalizing individual fields that deterministic validation flagged
#      as ambiguous (python/llm.py)
#   2. Identifying line items on documents where no table could be detected
#      visually (python/llm_line_items.py)
#
# Leave these blank to run without any LLM: ambiguous fields simply stay
# ambiguous and the no-table-detected fallback returns nothing, instead of
# the pipeline failing. Everything else (routing, OCR, geometry-based table
# extraction, validation) works fully without them.
#
# NEVER prefix these with NEXT_PUBLIC_ — that would ship your API key to
# every browser that loads the page.

# Full chat-completions URL for your deployment, e.g.
# https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-15-preview
AZURE_FOUNDRY_ENDPOINT=

# Your Azure AI Foundry / Azure OpenAI API key.
AZURE_FOUNDRY_API_KEY=

# The deployment/model name to send in the request body, e.g. gpt-4o-mini
AZURE_FOUNDRY_MODEL=
